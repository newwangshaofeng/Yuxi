      "split": "development"
    },
    {
      "name": "年度排除期次汇总",
      "tool": "annual_output",
      "args": {
        "period_code": "FYP15_BASE",
        "start_year": 2024,
        "end_year": 2025,
        "mineral_id": "M01"
      },
      "checks": {
        "rows.0.output_total": "10.1000",
        "rows.1.output_total": "20.2000",
        "rows.1.stat_year": 2025
