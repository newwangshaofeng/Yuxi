        "offset": 99
      },
      "checks": {
        "rows": [],
        "summary.total": 5,
        "has_more": false
      },
      "split": "development"
    },
    {
      "name": "保有精确差值",
      "tool": "compare_reserves",
      "args": {
        "from_period": "FYP14_BASE",
        "to_period": "FYP15_BASE",
        "mineral_id": "M01"
      },
      "checks": {
        "rows.0.delta": "25.0250",
        "rows.0.change_percent": "25.0000"
      },
      "split": "development"
    },
    {
      "name": "累计口径",
      "tool": "compare_reserves",
      "args": {
        "from_period": "FYP14_BASE",
        "to_period": "FYP15_BASE",
