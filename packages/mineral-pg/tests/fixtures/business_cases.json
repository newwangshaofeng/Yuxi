{
  "version": 1,
  "note": "Synthetic frozen business oracle. Not a natural-language or production-data benchmark.",
  "cases": [
    {
      "name": "真实基期",
      "tool": "list_periods",
      "args": {},
      "checks": {
        "rows.0.start_year": 2020,
        "rows.0.period_role": "base"
      },
      "split": "development"
    },
    {
      "name": "标准矿种",
      "tool": "list_minerals",
      "args": {
        "limit": 1
      },
      "checks": {
        "rows.0.mineral_id": "M01",
        "has_more": true
      },
      "split": "development"
    },
    {
      "name": "矿山快照",
      "tool": "compare_entities",
      "args": {
        "entity_kind": "mine",
        "from_period": "FYP14_BASE",
        "to_period": "FYP15_BASE"
      },
      "checks": {
        "summary.total": 5,
        "summary.modified": 2,
        "summary.appeared": 1,
        "summary.disappeared": 1,
        "summary.unchanged": 1
      },
      "split": "development"
    },
    {
      "name": "探矿权换证",
      "tool": "compare_entities",
      "args": {
        "entity_kind": "explore_right",
        "from_period": "FYP14_BASE",
        "to_period": "FYP15_BASE"
      },
      "checks": {
        "summary.total": 3,
        "summary.modified": 1,
        "summary.appeared": 1
      },
      "split": "development"
    },
